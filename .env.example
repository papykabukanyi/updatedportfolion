# Copy this file to .env.local and fill in your values.
# NEVER commit .env or .env.local — both are listed in .gitignore.

# Resend API key, used by the contact form (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key

# The recipient address for contact form messages
CONTACT_RECIPIENT=your_gmail_address@gmail.com

# The public URL of your deployed site (used for SEO canonical URLs, sitemap, OG meta)
# Set this on Render / production to your public domain
NEXT_PUBLIC_SITE_URL=https://your-app.onrender.com

# Links to sibling apps
NEXT_PUBLIC_CROW_URL=https://your-crow-app.example.com
NEXT_PUBLIC_PAPYS_STORE_URL=https://your-store-app.example.com
NEXT_PUBLIC_CONSTRUCTION_URL=https://your-construction-app.example.com
NEXT_PUBLIC_ADMIN_URL=https://your-admin-app.example.com

# Postgres connection string (Supabase, Render Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname
